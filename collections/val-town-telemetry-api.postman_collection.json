                  "value": "<uuid>",
                  "description": "Branch IDs to filter by"
                },
                {
                  "disabled": false,
                  "key": "direction",
                  "value": "desc",
                  "description": "(Required) Sort direction for the traces. Defaults to descending order of timestamp."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "Start date of the time window (earliest time)"
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "End date of the time window (latest time)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "(Required) Maximum items to return in each paginated response"
                },
                {
                  "disabled": false,
                  "key": "order_by",
                  "value": "start_time",
                  "description": "When set to end_time, traces are sorted by their end time, and pending traces are omitted. When set to start_time, all traces are included, with pending traces given \"0\" for their end time."
                }
