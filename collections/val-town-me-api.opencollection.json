                "description": "Number of items to skip in order to deliver paginated results"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum items to return in each paginated response"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "[BETA] List all of a user's vals for authenticated users"
